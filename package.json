{
  "name": "sr-ekf",
  "version": "1.0.0",
  "description": "Production-grade Square-Root Extended Kalman Filter for IMU+GPS fusion on mobile",
  "type": "module",
  "main": "./dist/sr-ekf.js",
  "types": "./dist/sr-ekf.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sr-ekf.js",
      "types": "./dist/sr-ekf.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "AGENTS.md"
